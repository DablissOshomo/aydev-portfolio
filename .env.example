# Copy this file to .env for local development (never commit the real .env).
# On your host (Render/Railway/Fly/etc.), set these as environment variables
# in the dashboard instead of uploading a .env file.

# The password for /admin. Required — the admin login always fails without it.
ADMIN_PASSWORD=Daramolaayomide2001

# Used to sign session cookies. Required in production — set it to a long
# random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=Daramolaayomide2001

# Set automatically by most hosts — only needed locally if you want a
# non-default port.
PORT=3000

# Set to "production" on your host so session cookies require HTTPS.
NODE_ENV=development
